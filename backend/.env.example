# Rename this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (already TLS-encrypted in transit)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mern-portfolio-todo?retryWrites=true&w=majority

# JWT — use two DIFFERENT long random strings, not the same value twice
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
